# Copy to .env.local and fill in real values before running the app.
# Never commit .env.local — it's already covered by .gitignore.

# --- Database ---------------------------------------------------------
# PostgreSQL connection strings used by Prisma.
# For local development, set both to your local PostgreSQL URL.
# For Supabase on Vercel:
#   DATABASE_URL = Supabase "Transaction" connection pooler (port 6543) with ?pgbouncer=true
#   DIRECT_URL   = Supabase "Session" direct connection (port 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filevault?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/filevault?schema=public"

# --- Seed admin account -------------------------------------------------
# Used by `npm run prisma:seed` to create the initial admin account.
# Change ADMIN_PASSWORD before running against anything but a local database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123!

# --- Sessions -----------------------------------------------------------
# Random string used to sign session tokens. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-random-32-plus-character-string

# --- File storage ---------------------------------------------------------
# Set to "local" for local disk storage, or "supabase" for Vercel / cloud deployments.
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=100

# When UPLOAD_STORAGE_PROVIDER=supabase (on Vercel):
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJh......
# SUPABASE_STORAGE_BUCKET=filevault-uploads

# --- Sensor Platform v3 ---------------------------------------------------
SENSOR_TOKEN_SECRET=sensor-platform-token-secret-default-32-chars-long